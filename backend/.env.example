# 先导入 sql/禾诊_MySQL初始化.sql；密码中的 @、:、/ 等字符需 URL 编码
DATABASE_URL=mysql+pymysql://hezhen_app:YOUR_PASSWORD@127.0.0.1:3306/hezhen_db?charset=utf8mb4

# 用户登录令牌签名密钥，至少 32 字节随机字符串；不要提交真实值
AUTH_SECRET_KEY=

# 可选：兼容管理员接口凭证；留空时仅允许数据库中 role=admin 的登录用户
ADMIN_API_TOKEN=

# 可选：网页没有临时填写 API 密钥时，使用这里的后端兜底密钥
DEEPSEEK_API_KEY=

# 多个来源用英文逗号分隔；本地 5173 端口已默认允许
WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

INFERENCE_DEVICE=auto
MAX_UPLOAD_MB=10
# 农作物/农产品图片校验（必须先准备本地权重；缺失时拒绝诊断）
IMAGE_GATE_MODEL_PATH=models/image_gate
# CLIP 余弦相似度及正负类别差值，不是准确率或概率
IMAGE_GATE_MIN_SIMILARITY=0.22
IMAGE_GATE_MIN_MARGIN=0.02
